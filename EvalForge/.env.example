# Demo mode (default): fully offline, no API keys or database needed.
MOCK_MODE=true
PROVIDER=mock

# Live mode: set MOCK_MODE=false and pick a provider.
# PROVIDER=groq            # or: anthropic
# MODEL=openai/gpt-oss-120b  # defaults: groq=openai/gpt-oss-120b, anthropic=claude-sonnet-4-6
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# DATABASE_URL=postgresql://user:pass@host/db   # required for live runs
# BASELINE_RUN_ID=         # run_id to compare against; unset = this run becomes the baseline

MAX_CONCURRENT_CALLS=3
JUDGE_TEMPERATURE=0.0
